# Anvaya AI OS - Backend API

## Environment Variables

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/anvaya

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Provider
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4

# Embedding
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# External Services
AGENT_REACH_ENDPOINT=
OCR_ENDPOINT=

# MCP
MCP_ENABLED=false

# Automation
N8N_WEBHOOK_URL=
MAKE_WEBHOOK_URL=

# Energy
ENERGY_MODE=BALANCED

# Cache
CACHE_ENABLED=true
CACHE_TTL=3600

# Workers
WORKER_ENABLED=true

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
